diff --git a/NAM/weights_iterator.h b/NAM/weights_iterator.h
new file mode 100644
index 0000000..7c90344
--- /dev/null
+++ b/NAM/weights_iterator.h
@@ -0,0 +1,56 @@
+#pragma once
+// A weights cursor that knows where the weights end. Every set_weights_ walks the flat weight list with *(it++); a
+// model file whose weight count does not match its architecture used to read past the end of the list (heap overflow
+// while the network was built). Reading past the end now throws instead.
+
+#include <cstddef>
+#include <stdexcept>
+#include <type_traits>
+#include <vector>
+
+namespace nam
+{
+template <typename T>
+class BasicWeightsIterator
+{
+public:
+  using Vector = typename std::conditional<std::is_const<T>::value, const std::vector<float>, std::vector<float>>::type;
+
+  BasicWeightsIterator() = default;
+  explicit BasicWeightsIterator(Vector& weights)
+  : _data(weights.data())
+  , _size(weights.size())
+  {
+  }
+
+  T& operator*() const
+  {
+    if (_pos >= _size)
+      throw std::runtime_error("Weight mismatch: the model expects more weights than were provided.");
+    return _data[_pos];
+  }
+  BasicWeightsIterator& operator++()
+  {
+    ++_pos;
+    return *this;
+  }
+  BasicWeightsIterator operator++(int)
+  {
+    BasicWeightsIterator before = *this;
+    ++_pos;
+    return before;
+  }
+
+  bool at_end() const { return _pos == _size; }
+  size_t consumed() const { return _pos; }
+  size_t size() const { return _size; }
+
+private:
+  T* _data = nullptr;
+  size_t _size = 0;
+  size_t _pos = 0;
+};
+
+using weights_iterator = BasicWeightsIterator<float>;
+using const_weights_iterator = BasicWeightsIterator<const float>;
+} // namespace nam
