+
+    // The idle timer runs only while the view is in a window. Hosts close the editor and dispose of the plugin while
+    // the (autoreleased) view can still be alive for a moment; a timer left running then idled a UI whose plugin was
+    // already gone (Renoise: SIGSEGV in the timer callback after "Uninitialize"). Invalidating works from any thread
+    // and removes the timer from every run loop it was added to.
+    void startIdle()
+    {
         if (fTimerRef != nullptr)
-        {
-            CFRunLoopRemoveTimer(CFRunLoopGetCurrent(), fTimerRef, kCFRunLoopCommonModes);
-            CFRelease(fTimerRef);
-        }
+            return;
+
+        constexpr const CFTimeInterval interval = 60 * 0.0001;
+
+        CFRunLoopTimerContext context = {};
+        context.info = this;
+        fTimerRef = CFRunLoopTimerCreate(kCFAllocatorDefault, CFAbsoluteTimeGetCurrent() + interval, interval, 0, 0,
+                                         _idleCallback, &context);
+        DISTRHO_SAFE_ASSERT_RETURN(fTimerRef != nullptr,);
+
+        CFRunLoopAddTimer(CFRunLoopGetMain(), fTimerRef, kCFRunLoopCommonModes);
+    }
+
+    void stopIdle()
+    {
+        if (fTimerRef == nullptr)
+            return;
+
+        CFRunLoopTimerInvalidate(fTimerRef);
+        CFRelease(fTimerRef);
+        fTimerRef = nullptr;
     }
 
