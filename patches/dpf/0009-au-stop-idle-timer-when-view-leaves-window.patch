+- (void) viewWillMoveToWindow:(NSWindow*)newWindow
+{
+    // leaving its window (the editor closed, or the host took the view away): stop idling the UI at once
+    if (ui != nullptr)
+    {
+        if (newWindow == nil)
+            ui->stopIdle();
+        else
+            ui->startIdle();
+    }
+
+    [super viewWillMoveToWindow:newWindow];
+}
